# Sample environment variables

# App
APP_HOST=0.0.0.0
APP_PORT=8000
NODE_ENV=development

# DB
POSTGRES_DB=virasphere
POSTGRES_USER=virasphere
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# JWT
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=7d

# Redis for queues
REDIS_URL=redis://redis:6379

# SMS/Voice Provider (example: twilio)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_sid_here
TWILIO_AUTH_TOKEN=your_token_here
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# Email Provider (example: sendgrid)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=your_sendgrid_key
EMAIL_FROM=hello@yourdomain.com

# Payments (Stripe sandbox)
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# AI Provider (primary)
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...

# Fallback local model endpoint (ai service)
LOCAL_AI_URL=http://ai:8500/generate

# Webhook base URL
WEBHOOK_BASE=https://dashboard.example.com/webhooks
